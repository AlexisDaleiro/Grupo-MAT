# Copiá este archivo a .env y completá los valores solo en tu entorno local.
# No guardes credenciales reales en este archivo.

# Servidor: secretos para /api/contact. Nunca los expongas en variables PUBLIC_*.
# Requerida en producción; puede faltar en desarrollo.
RESEND_API_KEY=
# Destinatario requerido para enviar consultas.
CONTACT_TO_EMAIL=
# Opcional: remitente con dominio verificado en Resend.
CONTACT_FROM_EMAIL=

# Cliente: valores públicos. Los opcionales pueden quedar vacíos.
# Si no se define, se usa el número indicado en la especificación.
PUBLIC_WHATSAPP=
# Sin URL, el CTA de agenda apunta a /contacto.
PUBLIC_CALENDLY_URL=
# Sin ID, no se carga Google Analytics.
PUBLIC_GA_ID=
# Sin URL, no se muestran los enlaces a redes.
PUBLIC_INSTAGRAM_URL=
PUBLIC_LINKEDIN_URL=
