---
import '@/styles/global.css';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import Seo from '@/components/layout/Seo.astro';
import SkipLink from '@/components/layout/SkipLink.astro';
import Nav from '@/components/layout/Nav.astro';
import Footer from '@/components/layout/Footer.astro';
import WhatsAppButton from '@/components/layout/WhatsAppButton.astro';
import Analytics from '@/components/layout/Analytics.astro';
import type { BreadcrumbItem, SeoImage, ServiceMetadata } from '@/lib/seo';

interface Props {
  title?: string; description?: string; image?: SeoImage; hasHero?: boolean;
  canonical?: string; breadcrumbs?: readonly BreadcrumbItem[]; service?: ServiceMetadata; noindex?: boolean;
}
const { title, description, image, canonical, breadcrumbs, service, noindex, hasHero = false } = Astro.props;
---

<!doctype html>
<html lang="es-UY" data-theme="light" data-language="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#FFF4EE" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let language = 'es';
        try {
          if (localStorage.getItem('language') === 'en') language = 'en';
        } catch {}
        root.dataset.language = language;
        root.lang = language === 'en' ? 'en' : 'es-UY';
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          root.classList.add('motion-ok');
          setTimeout(() => {
            if (!window.__motionReady) root.classList.remove('motion-ok');
          }, 3000);
        }
      })();
    </script>
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin fetchpriority="high" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Seo title={title} description={description} image={image} canonical={canonical} breadcrumbs={breadcrumbs} service={service} noindex={noindex} />
    <Analytics />
  </head>
  <body>
    <SkipLink />
    <Nav hasHero={hasHero} />
    <main id="contenido" tabindex="-1" class:list={{ 'main-inset': !hasHero }}>
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
    <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-language-status></p>
    <script>
      import '@/scripts/nav';
      import '@/scripts/spotlight';
      import '@/scripts/analytics';
      // Priorizá los recursos iniciales y el pintado antes del núcleo de movimiento.
      const loadMotion = () => requestAnimationFrame(() => requestAnimationFrame(() => {
        void import('@/scripts/motion').catch(() => {
          document.documentElement.classList.remove('motion-ok');
        });
      }));
      if (document.readyState === 'complete') loadMotion();
      else window.addEventListener('load', loadMotion, { once: true });
    </script>
  </body>
</html>

<style>
  :global(body) { display: flex; flex-direction: column; }
  main { flex: 1; }
  .main-inset { padding-top: 64px; }
</style>
