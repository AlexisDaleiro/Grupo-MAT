---
import { getCollection, getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { Icon } from 'astro-icon/components';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/sections/PageHeader.astro';
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import SpotlightCard from '@/components/ui/SpotlightCard.astro';
import ProjectCard from '@/components/ui/ProjectCard.astro';
import CompactProcess from '@/components/sections/CompactProcess.astro';
import FinalCta from '@/components/sections/FinalCta.astro';
import { byOrder } from '@/lib/content';

export const getStaticPaths = (async () => (await getCollection('servicios')).sort(byOrder).map((service) => ({ params: { slug: service.id }, props: { service } }))) satisfies GetStaticPaths;
interface Props { service: CollectionEntry<'servicios'> }
const { service } = Astro.props;
const { data } = service;
const relatedProject = data.relatedProject ? await getEntry(data.relatedProject) : undefined;
if (data.relatedProject && !relatedProject) throw new Error(`No existe el proyecto relacionado de ${service.id}.`);
---

<BaseLayout title={data.seoTitle} description={data.seoDescription} hasHero>
  <PageHeader eyebrow="Servicios" title={data.headline} lead={data.lead} appointment />
  <section class="section-space audience" aria-labelledby="audience-title">
    <Container><div class="audience-grid"><SectionHeading id="audience-title" title="Para quién es" reveal /><p class="text-lead" data-reveal>{data.audience}</p></div></Container>
  </section>
  <section class="section-space problems" aria-labelledby="problems-title">
    <Container>
      <SectionHeading id="problems-title" title="Problemas que resolvemos" reveal />
      <div class="problems-grid" data-spotlight-group>{data.problems.map((problem) => <SpotlightCard class="problem-card" data-reveal><Icon name={data.icon} size={24} aria-hidden="true" /><h3>{problem}</h3></SpotlightCard>)}</div>
    </Container>
  </section>
  <section class="section-space" aria-labelledby="includes-title">
    <Container><div class="includes-grid">
      <SectionHeading id="includes-title" title="Qué incluye" reveal />
      <div><ul class="includes-list" role="list">{data.includes.map((item) => <li data-reveal><Icon name="lucide:check" size={19} aria-hidden="true" /><span>{item}</span></li>)}</ul><p class="timeline" data-reveal><span>Plazo</span><strong>{data.timeline}</strong></p></div>
    </div></Container>
  </section>
  <CompactProcess />
  {relatedProject && <section class="section-space related-project" aria-labelledby="related-title"><Container><SectionHeading id="related-title" title="Proyecto relacionado" reveal /><div class="related-grid" data-spotlight-group><ProjectCard project={relatedProject} /></div></Container></section>}
  <FinalCta />
</BaseLayout>

<style>
  .audience-grid, .includes-grid { display: grid; gap: 2rem; }
  .audience { border-bottom: 1px solid var(--line); }
  .problems { border-bottom: 1px solid var(--line); }
  .problems-grid { display: grid; gap: 1rem; margin-top: 3rem; }
  :global(.problem-card) { display: grid; align-content: start; gap: 1.5rem; padding: 1.75rem; }
  :global(.problem-card svg) { color: var(--brand-text); }
  .problems-grid h3 { font-size: 1.125rem; line-height: 1.5; }
  .includes-list { display: grid; gap: 1.25rem; }
  .includes-list li { display: flex; align-items: start; gap: .875rem; }
  .includes-list :global(svg) { margin-top: .3rem; flex-shrink: 0; color: var(--brand-text); }
  .timeline { display: grid; gap: .75rem; margin-top: 2.5rem; border-left: 2px solid var(--brand); padding-left: 1.5rem; }
  .timeline span { color: var(--fg-muted); font-family: var(--font-mono); font-size: .75rem; text-transform: uppercase; letter-spacing: .14em; }
  .timeline strong { font-family: var(--font-mono); font-size: .9375rem; font-weight: 500; }
  .related-project { border-top: 1px solid var(--line); }
  .related-grid { display: grid; margin-top: 3rem; max-width: 34rem; }
  @media (width >= 48rem) { .problems-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (width >= 64rem) { .audience-grid, .includes-grid { grid-template-columns: 1fr 1fr; gap: 5rem; } .problems-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>
