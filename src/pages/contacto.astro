---
import Text from '@/components/ui/Text.astro';
import { Icon } from 'astro-icon/components';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/sections/PageHeader.astro';
import Container from '@/components/ui/Container.astro';
import SpotlightCard from '@/components/ui/SpotlightCard.astro';
import ContactFormBlock from '@/components/ui/ContactFormBlock.astro';
import { contact } from '@/data/site';
---

<BaseLayout title="Contacto · Grupo MAT" description="Elegí el canal que te quede más cómodo. La primera llamada no tiene costo." breadcrumbs={[{ name: 'Contacto', path: '/contacto' }]} hasHero>
  <PageHeader title="Hablemos de tu proyecto" lead="Elegí el canal que te quede más cómodo. La primera llamada no tiene costo." />
  <section class="contact-channels section-space" aria-labelledby="channels-title">
    <Container>
      <h2 id="channels-title" class="sr-only"><Text text={"Canales de contacto"} /></h2>
      <div class="channels-grid" data-spotlight-group>
        {contact.calendlyUrl && <SpotlightCard class="channel-card" data-reveal><Icon name="lucide:calendar" size={28} aria-hidden="true" /><h3><a href={contact.calendlyUrl} target="_blank" rel="noopener"><Text text={"Agendar una llamada"} /><Icon name="lucide:arrow-up-right" size={18} aria-hidden="true" /></a></h3><p><Text text={"Elegí el horario que te quede cómodo."} /></p></SpotlightCard>}
        {contact.whatsappUrl && <SpotlightCard class="channel-card" data-reveal><Icon name="simple-icons:whatsapp" size={28} aria-hidden="true" /><h3><a href={contact.whatsappUrl} target="_blank" rel="noopener"><Text text={"WhatsApp"} /><Icon name="lucide:arrow-up-right" size={18} aria-hidden="true" /></a></h3><p>{contact.whatsappLabel}</p></SpotlightCard>}
        <SpotlightCard class="channel-card" data-reveal><Icon name="lucide:message-square" size={28} aria-hidden="true" /><h3><a href="#formulario"><Text text={"Formulario"} /><Icon name="lucide:arrow-down" size={18} aria-hidden="true" /></a></h3><p><Text text={"Contanos sobre tu proyecto."} /></p></SpotlightCard>
      </div>
    </Container>
  </section>
  <section id="formulario" tabindex="-1" class="contact-form section-space" data-final-cta aria-labelledby="form-title">
    <Container><div class="form-grid"><div><h2 id="form-title" data-reveal><Text text={"Formulario"} /></h2><p class="text-lead" data-reveal><Text text={"Dejanos tus datos y te contactamos para hablar de tu proyecto."} /></p></div><ContactFormBlock /></div></Container>
  </section>
</BaseLayout>

<style>
  .contact-channels { border-bottom: 1px solid var(--line); }
  .channels-grid { display: grid; gap: 1rem; }
  :global(.channel-card) { display: grid; align-content: start; justify-items: start; gap: 1.25rem; padding: 2rem; }
  :global(.channel-card > svg) { color: var(--brand-text); }
  .channel-card h3 { width: 100%; }
  .channel-card h3 a { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 44px; text-decoration: none; }
  .channel-card a:hover { color: var(--brand-text); }
  .channel-card p { color: var(--fg-muted); }
  .form-grid { display: grid; align-items: start; gap: 2.5rem; }
  .form-grid .text-lead { margin-top: 1.5rem; }
  @media (width >= 48rem) { .channels-grid { grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); } }
  @media (width >= 64rem) { .form-grid { grid-template-columns: 1fr 1fr; gap: 5rem; } }
</style>
