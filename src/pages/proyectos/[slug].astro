---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/sections/PageHeader.astro';
import Container from '@/components/ui/Container.astro';
import ProjectMedia from '@/components/ui/ProjectMedia.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import FinalCta from '@/components/sections/FinalCta.astro';
import { byOrder, projectStatus } from '@/lib/content';
import '@/styles/prose.css';

export const getStaticPaths = (async () => (await getCollection('proyectos')).sort(byOrder).map((project) => ({ params: { slug: project.id }, props: { project } }))) satisfies GetStaticPaths;
interface Props { project: CollectionEntry<'proyectos'> }
const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const metadata = [
  ['Cliente', data.client], ['Rubro', data.industry], ['Servicio', data.services.join(' · ')],
  ['Stack', data.stack.join(' · ')], ['Integraciones', data.integrations.join(' · ')],
  ['Estado', projectStatus(data.status)], ...(data.launchEstimate ? [['Lanzamiento estimado', data.launchEstimate]] : []),
].filter(([, value]) => Boolean(value));
---

<BaseLayout title={data.seoTitle} description={data.seoDescription} image={data.cover?.src} hasHero>
  <PageHeader title={data.title} lead={data.summary}>
    <Fragment slot="badges"><Badge variant="status">{projectStatus(data.status)}</Badge>{data.services.map((service) => <Badge>{service}</Badge>)}</Fragment>
  </PageHeader>
  <section class="project-overview" aria-labelledby="project-overview-title">
    <Container>
      <h2 id="project-overview-title" class="sr-only">Ficha del proyecto</h2>
      {data.logo && <Image src={data.logo} alt={`Logo de ${data.client}`} width={160} height={Math.round(160 * data.logo.height / data.logo.width)} format="webp" loading="lazy" class="project-logo" />}
      <dl>{metadata.map(([label, value]) => <div data-reveal><dt>{label}</dt><dd>{value}</dd></div>)}</dl>
    </Container>
  </section>
  <section class="project-images" aria-labelledby="project-images-title">
    <Container>
      <h2 id="project-images-title" class="sr-only">Imágenes de {data.title}</h2>
      <div class="project-visual"><ProjectMedia image={data.cover} name={data.title} /></div>
      {data.gallery && data.gallery.length > 0 && <div class="project-gallery">{data.gallery.map((image, index) => <figure><ProjectMedia image={image} name={data.title} alt={`Captura ${index + 1} de ${data.title}`} /></figure>)}</div>}
    </Container>
  </section>
  <section class="section-space" aria-labelledby="project-body-title">
    <Container>
      <h2 id="project-body-title" class="sr-only">Sobre el proyecto</h2>
      <div class="prose"><Content /></div>
      {(data.liveUrl || (data.isOwnProject && data.repoUrl)) && <div class="project-links">{data.liveUrl && <Button href={data.liveUrl} target="_blank" arrow>Ver sitio</Button>}{data.isOwnProject && data.repoUrl && <Button href={data.repoUrl} target="_blank" variant="secondary" arrow>Ver repositorio</Button>}</div>}
    </Container>
  </section>
  <FinalCta />
</BaseLayout>

<style>
  .project-overview { border-bottom: 1px solid var(--line); padding-block: 3rem; }
  .project-logo { max-height: 6rem; width: auto; margin-bottom: 2rem; object-fit: contain; }
  dl { display: grid; gap: 2rem; }
  dt { margin-bottom: .5rem; color: var(--fg-muted); font-family: var(--font-mono); font-size: .75rem; }
  dd { font-size: .9375rem; }
  .project-images { padding-top: 3rem; }
  .project-visual, .project-gallery figure { overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius-card); }
  .project-visual :global(.project-placeholder) { border: 0; border-radius: 0; }
  .project-gallery { display: grid; gap: 1.5rem; margin-top: 1.5rem; }
  .project-links { display: flex; flex-wrap: wrap; gap: 1rem; max-width: 48rem; margin: 3rem auto 0; }
  @media (width >= 48rem) { dl { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
