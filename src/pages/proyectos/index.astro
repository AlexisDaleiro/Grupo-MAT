---
import Text from '@/components/ui/Text.astro';
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/sections/PageHeader.astro';
import Container from '@/components/ui/Container.astro';
import ProjectCard from '@/components/ui/ProjectCard.astro';
import { Icon } from 'astro-icon/components';
import { byOrder } from '@/lib/content';

const projects = (await getCollection('proyectos')).sort(byOrder);
---

<BaseLayout title="Proyectos · Grupo MAT" description="Lo que estamos construyendo con nuestros clientes." breadcrumbs={[{ name: 'Proyectos', path: '/proyectos' }]} hasHero>
  <PageHeader title="Proyectos" lead="Lo que estamos construyendo con nuestros clientes." />
  <section class="section-space" aria-labelledby="project-list-title">
    <Container>
      <h2 id="project-list-title" class="sr-only"><Text text={"Nuestros proyectos"} /></h2>
      <div class="projects-grid" data-spotlight-group>
        {projects.map((project) => <ProjectCard project={project} />)}
        {projects.length < 3 && <a href="/contacto" class="next-project" data-reveal><span class="next-project__icon" aria-hidden="true"><Icon name="lucide:plus" size={28} /></span><h3><Text text={"Tu proyecto puede ser el próximo."} /></h3><Icon name="lucide:arrow-up-right" size={24} aria-hidden="true" /></a>}
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .projects-grid { display: grid; gap: 1.5rem; }
  .next-project { display: flex; flex-direction: column; justify-content: center; align-items: start; gap: 1.5rem; min-height: 22rem; border: 1px dashed var(--line); border-radius: var(--radius-card); padding: 2rem; text-decoration: none; }
  .next-project:hover { border-color: var(--brand); }
  .next-project h3 { max-width: 17ch; font-size: clamp(1.5rem, 1.1rem + 1vw, 2rem); }
  .next-project__icon { display: grid; place-items: center; width: 56px; height: 56px; border: 1px solid var(--line); border-radius: 50%; color: var(--brand-text); }
  .next-project > :global(svg) { color: var(--brand-text); }
  @media (width >= 48rem) { .projects-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .next-project { padding: 3rem; } }
</style>
