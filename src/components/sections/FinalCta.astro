---
import { Icon } from 'astro-icon/components';
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import { contact } from '@/data/site';
---

<section id="contacto" class="section-space final-cta" data-final-cta data-theme="dark" aria-labelledby="contact-title">
  <Container>
    <div class="contact-grid">
      <div class="contact-copy">
        <h2 id="contact-title" data-reveal>¿Tenés un proyecto en mente?</h2>
        <p class="text-lead" data-reveal>Contanos qué necesitás y te respondemos con una propuesta clara.</p>
        <div class="contact-channels" data-reveal>
          {contact.calendlyUrl && <a href={contact.calendlyUrl} target="_blank" rel="noopener"><Icon name="lucide:calendar" size={22} aria-hidden="true" /><span><strong>Agendá una llamada</strong><span>Elegí el horario que te quede cómodo.</span></span><Icon name="lucide:arrow-up-right" size={18} aria-hidden="true" /></a>}
          {contact.whatsappUrl && <a href={contact.whatsappUrl} target="_blank" rel="noopener"><Icon name="simple-icons:whatsapp" size={22} aria-hidden="true" /><span><strong>Escribinos por WhatsApp</strong><span>{contact.whatsappLabel}</span></span><Icon name="lucide:arrow-up-right" size={18} aria-hidden="true" /></a>}
        </div>
      </div>
      <div class="contact-placeholder" data-reveal>
        <!-- Placeholder estático autorizado para Fase 3. Se reemplaza por ContactForm en Fase 5. -->
        <div class="contact-preview" aria-hidden="true" inert>
          <div class="contact-preview__row"><div>Nombre<span></span></div><div>Empresa<span></span></div></div>
          <div>Email de trabajo<span></span></div>
          <div>Contanos sobre tu proyecto<span class="contact-preview__message"></span></div>
        </div>
        <p>El formulario estará disponible próximamente.</p>
        {contact.whatsappUrl && <Button href={contact.whatsappUrl} target="_blank" variant="secondary" arrow>Escribinos por WhatsApp</Button>}
      </div>
    </div>
  </Container>
</section>

<style>
  .final-cta { position: relative; isolation: isolate; overflow: hidden; background: var(--canvas); color: var(--fg); }
  .final-cta::before { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none; background-image: linear-gradient(rgb(148 163 184 / .035) 1px, transparent 1px), linear-gradient(90deg, rgb(148 163 184 / .035) 1px, transparent 1px); background-size: 64px 64px; mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, #000 40%, transparent 100%); }
  .contact-grid { display: grid; align-items: start; gap: 3rem; }
  .contact-copy { display: grid; gap: 1.5rem; }
  .contact-channels { display: grid; gap: 1rem; margin-top: .5rem; }
  .contact-channels a { display: flex; align-items: center; gap: 1rem; min-height: 64px; padding-block: .5rem; text-decoration: none; }
  .contact-channels a > :global(svg:first-child) { flex-shrink: 0; color: var(--brand-text); }
  .contact-channels a > :global(svg:last-child) { margin-left: auto; }
  .contact-channels strong { display: block; font-weight: 500; }
  .contact-channels span span { display: block; color: var(--fg-muted); font-size: .875rem; }
  .contact-channels a:hover strong { color: var(--brand-text); }
  .contact-placeholder { display: grid; justify-items: start; gap: 1.25rem; padding: 1.5rem; border: 1px solid var(--line); border-radius: var(--radius-card); background: var(--surface); }
  .contact-placeholder > p { color: var(--fg-muted); font-size: .875rem; }
  .contact-preview { display: grid; gap: 1.25rem; width: 100%; color: var(--fg-muted); font-size: .8125rem; }
  .contact-preview__row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .contact-preview span { display: block; height: 44px; margin-top: .5rem; border: 1px solid var(--line); border-radius: var(--radius-input); background: var(--canvas); }
  .contact-preview .contact-preview__message { height: 100px; }
  @media (width >= 64rem) { .contact-grid { grid-template-columns: 1fr 1fr; gap: 5rem; } .contact-placeholder { padding: 2rem; } }
</style>
