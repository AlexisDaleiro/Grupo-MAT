---
import Text from '@/components/ui/Text.astro';
import { Icon } from 'astro-icon/components';
import Container from '@/components/ui/Container.astro';
import ContactFormBlock from '@/components/ui/ContactFormBlock.astro';
import { contact } from '@/data/site';
---

<section id="contacto" class="section-space final-cta" data-final-cta data-theme="dark" aria-labelledby="contact-title">
  <Container>
    <div class="contact-grid">
      <div class="contact-copy">
        <h2 id="contact-title" data-reveal><Text text={"¿Tenés un proyecto en mente?"} /></h2>
        <p class="text-lead" data-reveal><Text text={"Dejanos tus datos y te contactamos para hablar de tu proyecto."} /></p>
        <div class="contact-channels" data-reveal>
          {contact.calendlyUrl && <a href={contact.calendlyUrl} target="_blank" rel="noopener"><Icon name="lucide:calendar" size={22} aria-hidden="true" /><span><strong><Text text={"Agendá una llamada"} /></strong><span><Text text={"Elegí el horario que te quede cómodo."} /></span></span><Icon name="lucide:arrow-up-right" size={18} aria-hidden="true" /></a>}
          {contact.whatsappUrl && <a href={contact.whatsappUrl} target="_blank" rel="noopener"><Icon name="simple-icons:whatsapp" size={22} aria-hidden="true" /><span><strong><Text text={"Escribinos por WhatsApp"} /></strong><span>{contact.whatsappLabel}</span></span><Icon name="lucide:arrow-up-right" size={18} aria-hidden="true" /></a>}
        </div>
      </div>
      <ContactFormBlock />
    </div>
  </Container>
</section>

<style>
  .final-cta { position: relative; isolation: isolate; overflow: hidden; background: var(--canvas); color: var(--fg); }
  .final-cta::before { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none; background-image: linear-gradient(rgb(var(--grid-rgb) / .035) 1px, transparent 1px), linear-gradient(90deg, rgb(var(--grid-rgb) / .035) 1px, transparent 1px); background-size: 64px 64px; mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, #000 40%, transparent 100%); }
  .contact-grid { display: grid; align-items: start; gap: 3rem; }
  .contact-copy { display: grid; gap: 1.5rem; }
  .contact-channels { display: grid; gap: 1rem; margin-top: .5rem; }
  .contact-channels a { display: flex; align-items: center; gap: 1rem; min-height: 64px; padding-block: .5rem; text-decoration: none; }
  .contact-channels a > :global(svg:first-child) { flex-shrink: 0; color: var(--brand-text); }
  .contact-channels a > :global(svg:last-child) { margin-left: auto; }
  .contact-channels strong { display: block; font-weight: 500; }
  .contact-channels a > span > span { display: block; color: var(--fg-muted); font-size: .875rem; }
  .contact-channels a:hover strong { color: var(--brand-text); }
  @media (width >= 64rem) { .contact-grid { grid-template-columns: 1fr 1fr; gap: 5rem; } }
</style>
