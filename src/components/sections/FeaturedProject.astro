---
import Container from '@/components/ui/Container.astro';
import ProjectPlaceholder from '@/components/ui/ProjectPlaceholder.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import { featuredProject as project } from '@/data/site';
---

<section id="proyectos" class="section-space" aria-labelledby="project-title">
  <Container>
    <div class="project-grid">
      <div class="project-visual" data-project-visual>
        <div data-project-image><ProjectPlaceholder name={project.title} /></div>
      </div>
      <div class="project-copy">
        <p class="eyebrow" data-reveal>Proyecto destacado</p>
        <div class="project-title" data-reveal><h2 id="project-title">{project.title}</h2><Badge variant="status">{project.status}</Badge></div>
        <p class="text-lead" data-reveal>{project.summary}</p>
        <dl data-reveal>
          {project.metadata.map(([label, value]) => <div><dt>{label}:</dt><dd>{value}</dd></div>)}
        </dl>
        <div data-reveal><Button href={project.href} variant="secondary" arrow>Ver el proyecto</Button></div>
      </div>
    </div>
  </Container>
</section>

<style>
  .project-grid { display: grid; align-items: center; gap: 2.5rem; }
  .project-visual { overflow: hidden; min-width: 0; border: 1px solid var(--line); border-radius: var(--radius-card); }
  .project-visual :global(.project-placeholder) { width: 100%; aspect-ratio: auto; border: 0; border-radius: 0; min-height: 22rem; }
  .project-copy { display: grid; justify-items: start; gap: 1.5rem; }
  .project-title { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; }
  dl { display: grid; gap: .625rem; font-family: var(--font-mono); font-size: .75rem; }
  dl div { display: flex; flex-wrap: wrap; gap: 0 .5rem; }
  dt { color: var(--fg-muted); } dd { color: var(--fg); }
  @media (width >= 64rem) { .project-grid { grid-template-columns: 1.05fr 1fr; gap: 3.5rem; } .project-visual :global(.project-placeholder) { min-height: 33rem; } }
</style>
