---
import Text from '@/components/ui/Text.astro';
import Container from '@/components/ui/Container.astro';
import { getCollection } from 'astro:content';
import ProjectMedia from '@/components/ui/ProjectMedia.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import { byOrder, projectStatus } from '@/lib/content';
const project = (await getCollection('proyectos', ({ data }) => data.featured)).sort(byOrder)[0];
const metadata = project ? [
  ['Rubro', project.data.industry], ['Servicio', project.data.services.join(' · ')],
  ['Stack', project.data.stack.join(' · ')], ['Integraciones', project.data.integrations.join(' · ')],
  ...(project.data.launchEstimate ? [['Lanzamiento estimado', project.data.launchEstimate.charAt(0).toLocaleLowerCase('es-UY') + project.data.launchEstimate.slice(1)]] : []),
].filter(([, value]) => Boolean(value)) : [];
---

{project && <section id="proyectos" class="section-space" aria-labelledby="project-title">
  <Container>
    <div class="project-grid">
      <div class="project-visual" data-project-visual>
        <div data-project-image><ProjectMedia image={project.data.cover} name={project.data.title} sizes="(min-width: 1024px) 528px, 100vw" /></div>
      </div>
      <div class="project-copy">
        <p class="eyebrow" data-reveal><Text text={"Proyecto destacado"} /></p>
        <div class="project-title" data-reveal><h2 id="project-title">{project.data.title}</h2><Badge variant="status"><Text text={projectStatus(project.data.status)} /></Badge></div>
        <p class="text-lead" data-reveal><Text text={project.data.summary} /></p>
        <dl data-reveal>
          {metadata.map(([label, value]) => <div><dt><Text text={label} />:</dt><dd><Text text={value} /></dd></div>)}
        </dl>
        <div data-reveal><Button href={`/proyectos/${project.id}`} variant="secondary" arrow><Text text={"Ver el proyecto"} /></Button></div>
      </div>
    </div>
  </Container>
</section>}

<style>
  .project-grid { display: grid; align-items: center; gap: 2.5rem; }
  .project-visual { overflow: hidden; min-width: 0; border: 1px solid var(--line); border-radius: var(--radius-card); }
  .project-visual :global(.project-placeholder) { width: 100%; aspect-ratio: auto; border: 0; border-radius: 0; min-height: 22rem; }
  .project-visual :global(picture img) { aspect-ratio: 1; object-fit: cover; }
  .project-copy { display: grid; justify-items: start; gap: 1.5rem; }
  .project-title { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; }
  dl { display: grid; gap: .625rem; font-family: var(--font-mono); font-size: .75rem; }
  dl div { display: flex; flex-wrap: wrap; gap: 0 .5rem; }
  dt { color: var(--fg-muted); } dd { color: var(--fg); }
  @media (width >= 64rem) { .project-grid { grid-template-columns: 1.05fr 1fr; gap: 3.5rem; } .project-visual :global(.project-placeholder) { min-height: 33rem; } }
</style>
