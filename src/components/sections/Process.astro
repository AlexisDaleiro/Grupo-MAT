---
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { processSteps } from '@/data/site';
---

<section id="proceso" class="section-space process" data-process aria-labelledby="process-title">
  <Container>
    <div class="process-grid">
      <div class="process-intro">
        <SectionHeading id="process-title" eyebrow="Proceso" title="Cómo trabajamos." lead="Un proceso claro, con avances que podés ver desde la primera semana." reveal />
        <div class="process-progress" aria-hidden="true"><span data-process-progress></span></div>
      </div>
      <ol class="process-steps" role="list">
        {processSteps.map((step) => (
          <li data-process-step>
            <div class="process-step" data-reveal>
              <span class="process-step__number" aria-hidden="true">{step.number}</span>
              <div><h3>{step.title}</h3><p>{step.text}</p></div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </Container>
</section>

<style>
  .process { border-block: 1px solid var(--line); }
  .process-grid { display: grid; gap: 3rem; }
  .process-progress { display: none; }
  .process-step { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: 1.25rem; padding-block: 2rem; border-top: 1px solid var(--line); }
  .process-step__number { color: var(--brand-text); font-family: var(--font-mono); font-size: .875rem; }
  .process-step h3 { margin-bottom: 1rem; }
  .process-step p { max-width: 42ch; color: var(--fg-muted); }
  @media (width >= 64rem) {
    .process-grid { grid-template-columns: 1fr 1fr; align-items: start; gap: 5rem; }
    .process-intro { position: sticky; top: 8rem; }
    .process-progress { display: block; width: 2px; height: 9rem; margin-top: 2.5rem; background: var(--line); }
    .process-progress span { display: block; height: 100%; background: var(--brand-text); transform-origin: top; }
    .process-step { min-height: 17rem; padding-block: 3rem; }
  }
</style>
