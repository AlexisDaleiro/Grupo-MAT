---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'article'> & { as?: 'article' | 'div' | 'li' };
const { as: Tag = 'article', class: className, ...attributes } = Astro.props;
---

<Tag {...attributes} class:list={['spotlight', className]}><slot /></Tag>

<style>
  .spotlight {
    position: relative;
    isolation: isolate;
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
    color: var(--fg);
    box-shadow: var(--shadow-card);
  }

  .spotlight::before, .spotlight::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms var(--ease-out-expo);
  }

  .spotlight::before {
    padding: 1px;
    background: radial-gradient(320px circle at var(--x, 50%) var(--y, 50%), var(--spot-border), transparent 70%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask-composite: exclude;
  }

  .spotlight::after {
    z-index: -1;
    background: radial-gradient(480px circle at var(--x, 50%) var(--y, 50%), var(--spot-fill), transparent 60%);
  }

  @media (hover: hover) and (pointer: fine) {
    :global([data-spotlight-group]:hover) .spotlight::before,
    .spotlight:hover::after { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .spotlight::before, .spotlight::after { transition: none; }
  }
</style>
