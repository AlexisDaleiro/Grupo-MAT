---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'span'> & { variant?: 'neutral' | 'status' };
const { variant = 'neutral', class: className, ...attributes } = Astro.props;
---

<span {...attributes} class:list={['badge', `badge--${variant}`, className]}>
  {variant === 'status' && <span class="badge__dot" aria-hidden="true"></span>}
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    max-width: 100%;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--surface-2);
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.5;
  }

  .badge--status { color: var(--brand-text); }
  .badge__dot { width: 6px; height: 6px; flex-shrink: 0; border-radius: 50%; background: currentColor; }

  @media (prefers-reduced-motion: no-preference) {
    .badge__dot { animation: status-pulse 2.4s ease-in-out infinite; }
  }

  @keyframes status-pulse { 50% { opacity: 0.4; } }
</style>
