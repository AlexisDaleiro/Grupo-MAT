---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'div'> & { as?: 'div' | 'section' | 'article' };
const { as: Tag = 'div', class: className, ...attributes } = Astro.props;
---

<Tag {...attributes} class:list={['container', className]}><slot /></Tag>

<style>
  .container { width: 100%; max-width: 72rem; margin-inline: auto; padding-inline: 1.25rem; }
  @media (width >= 48rem) { .container { padding-inline: 2rem; } }
</style>
