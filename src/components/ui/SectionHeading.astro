---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'div'> & {
  id: string;
  title: string;
  eyebrow?: string;
  lead?: string;
  align?: 'left' | 'center';
  reveal?: boolean;
};
const { id, title, eyebrow, lead, align = 'left', reveal = false, class: className, ...attributes } = Astro.props;
---

<div {...attributes} class:list={['section-heading', { 'section-heading--center': align === 'center' }, className]}>
  {eyebrow && <p class="eyebrow" data-reveal={reveal ? '' : undefined}>{eyebrow}</p>}
  <h2 id={id} data-reveal={reveal ? '' : undefined}>{title}</h2>
  {lead && <p class="text-lead" data-reveal={reveal ? '' : undefined}>{lead}</p>}
</div>

<style>
  .section-heading { display: grid; gap: 1rem; max-width: 52rem; color: var(--fg); }
  .section-heading--center { margin-inline: auto; text-align: center; justify-items: center; }
</style>
