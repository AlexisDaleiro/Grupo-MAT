---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ProjectPlaceholder from '@/components/ui/ProjectPlaceholder.astro';

interface Props { image?: ImageMetadata; name: string; alt?: string; sizes?: string }
const { image, name, alt = `Vista del proyecto ${name}`, sizes = '(min-width: 1152px) 1088px, 100vw' } = Astro.props;
const width = image ? Math.min(image.width, 1600) : 0;
const height = image ? Math.round(width * image.height / image.width) : 0;
const widths = image ? [...new Set([320, 640, 960, 1280, width].filter((value) => value <= width))].sort((a, b) => a - b) : [];
---

{image ? <Picture src={image} alt={alt} data-alt-en={alt.replace('Vista del proyecto', 'Project view:').replace(/Captura (\d+) de/u, 'Screenshot $1 of')} formats={['avif', 'webp']} width={width} height={height} widths={widths} sizes={sizes} loading="lazy" decoding="async" /> : <ProjectPlaceholder name={name} />}

<style>
  :global(.project-visual picture), :global(.project-card__visual picture), :global(.project-gallery picture) { display: block; width: 100%; }
  :global(.project-visual picture img), :global(.project-card__visual picture img), :global(.project-gallery picture img) { display: block; width: 100%; height: auto; }
</style>
