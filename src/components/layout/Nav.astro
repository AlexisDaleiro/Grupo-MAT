---
import Text from '@/components/ui/Text.astro';
import Container from '@/components/ui/Container.astro';
import Logo from '@/components/ui/Logo.astro';
import Button from '@/components/ui/Button.astro';
import LanguageToggle from './LanguageToggle.astro';
import MobileMenu from '@/components/islands/MobileMenu';
import { navigation, contact } from '@/data/site';
import '@/styles/mobile-menu.css';

interface Props { hasHero?: boolean }
const { hasHero = false } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/u, '') || '/';
---

<header class="site-header" data-site-header data-theme={hasHero ? 'dark' : undefined}>
  <Container class="nav-inner">
    <Logo />
    <nav class="nav-desktop" aria-label="Navegación principal" data-label-en="Main navigation">
      {navigation.map((item) => (
        <a href={item.href} data-nav-link aria-current={currentPath === item.href ? 'page' : undefined}><Text text={item.label} reserveSpace /></a>
      ))}
    </nav>
    <div class="nav-controls">
      <LanguageToggle />
      <div class="nav-appointment">
        <Button href={contact.appointmentUrl} target={contact.calendlyUrl ? '_blank' : undefined}><Text text={"Agendar una llamada"} reserveSpace /></Button>
      </div>
      <div class="nav-mobile">
        <MobileMenu navigation={navigation} currentPath={currentPath} appointmentUrl={contact.appointmentUrl} externalAppointment={Boolean(contact.calendlyUrl)} client:media="(max-width: 1023px)" />
        <noscript class="nav-noscript">
          <style is:inline>.nav-noscript { display: contents; }</style>
          <details class="nav-fallback">
            <summary>Menú</summary>
            <nav aria-label="Navegación principal móvil" class="nav-fallback-links">
              {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
              <a href={contact.appointmentUrl}>Agendar una llamada</a>
            </nav>
          </details>
        </noscript>
      </div>
    </div>
  </Container>
</header>

<style>
  .site-header { position: fixed; inset: 0 0 auto; z-index: 50; height: 64px; border-bottom: 1px solid transparent; background: var(--canvas); color: var(--fg); }
  .site-header[data-nav-ready]:not([data-scrolled]) { background: transparent; }
  .site-header[data-scrolled] {
    background: color-mix(in srgb, var(--canvas) 72%, transparent);
    border-color: var(--line);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    backdrop-filter: blur(16px) saturate(180%);
  }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; height: 100%; }
  .nav-controls { display: flex; align-items: center; gap: 0.625rem; }
  .nav-desktop { display: none; align-items: center; gap: 1.25rem; }
  .nav-desktop a { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; color: var(--fg-muted); font-size: 0.875rem; text-align: center; text-decoration: none; }
  .nav-desktop a:hover, .nav-desktop a[aria-current] { color: var(--fg); }
  .site-header[data-scrolled] .nav-desktop a { color: var(--fg); }
  .nav-appointment { display: none; }
  .nav-fallback summary { display: flex; align-items: center; min-width: 44px; min-height: 44px; cursor: pointer; }
  .nav-fallback-links { position: absolute; inset: 64px 0 auto; display: grid; max-height: calc(100svh - 64px); overflow-y: auto; padding: 1.25rem; border-bottom: 1px solid var(--line); background: var(--canvas); }
  .nav-fallback-links a { display: flex; align-items: center; min-height: 44px; color: var(--fg); }
  @media (width >= 48rem) { .nav-appointment { display: block; } }
  @media (width >= 64rem) { .nav-desktop { display: flex; } .nav-mobile { display: none; } }
  @media (prefers-reduced-motion: no-preference) {
    .site-header { transition: background-color 300ms, border-color 300ms; }
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .site-header[data-scrolled] { background: color-mix(in srgb, var(--canvas) 95%, transparent); }
  }
</style>
