---
import { Icon } from 'astro-icon/components';
import type { HTMLAttributes } from 'astro/types';

type Props = Omit<HTMLAttributes<'button'>, 'type' | 'aria-label' | 'aria-pressed'>;
const { class: className, ...attributes } = Astro.props;
---

<button
  {...attributes}
  type="button"
  class:list={['theme-toggle', className]}
  data-theme-toggle
  aria-label="Cambiar a modo oscuro"
  aria-pressed="false"
  hidden
>
  <Icon name="lucide:moon" size={20} class="theme-toggle__moon" aria-hidden="true" />
  <Icon name="lucide:sun" size={20} class="theme-toggle__sun" aria-hidden="true" />
</button>

<script>
  type Theme = 'light' | 'dark';
  const root = document.documentElement;
  const toggles = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  const systemTheme = matchMedia('(prefers-color-scheme: dark)');
  let hasPreference = false;
  let transitionTimeout: ReturnType<typeof setTimeout> | undefined;

  try {
    const stored = localStorage.getItem('theme');
    hasPreference = stored === 'light' || stored === 'dark';
  } catch {}

  function applyTheme(theme: Theme) {
    root.dataset.theme = theme;
    document.querySelector('meta[name="theme-color"]')?.setAttribute(
      'content', theme === 'dark' ? '#0F172A' : '#F8FAFC',
    );
    toggles.forEach((toggle) => {
      toggle.setAttribute('aria-label', `Cambiar a modo ${theme === 'dark' ? 'claro' : 'oscuro'}`);
      toggle.setAttribute('aria-pressed', String(theme === 'dark'));
      toggle.hidden = false;
    });
  }

  applyTheme(root.dataset.theme === 'dark' ? 'dark' : 'light');

  toggles.forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const theme: Theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
      clearTimeout(transitionTimeout);
      document.body.classList.add('theme-transition');
      applyTheme(theme);
      hasPreference = true;
      try {
        localStorage.setItem('theme', theme);
      } catch {}
      transitionTimeout = setTimeout(() => document.body.classList.remove('theme-transition'), 250);
    });
  });

  systemTheme.addEventListener('change', (event) => {
    if (!hasPreference) applyTheme(event.matches ? 'dark' : 'light');
  });

  window.addEventListener('storage', (event) => {
    if (event.key !== 'theme' && event.key !== null) return;
    hasPreference = event.newValue === 'light' || event.newValue === 'dark';
    applyTheme(hasPreference && event.newValue === 'dark' ? 'dark'
      : hasPreference ? 'light' : systemTheme.matches ? 'dark' : 'light');
  });
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--fg);
    cursor: pointer;
  }

  .theme-toggle:hover { border-color: var(--brand); }
  .theme-toggle__sun { display: none; }
  :global(:root[data-theme="dark"]) .theme-toggle__sun { display: block; }
  :global(:root[data-theme="dark"]) .theme-toggle__moon { display: none; }
</style>
